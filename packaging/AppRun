#!/usr/bin/env bash
# Launcher AppImage — configura Qt WebEngine y escala táctil Deck.
set -euo pipefail

HERE="$(dirname "$(readlink -f "${0}")")"
export YTMUSIC_APP_ROOT="${HERE}"

# shellcheck disable=SC1091
source "${HERE}/setup-runtime-env.sh"
ytmusic_setup_runtime_env

# Steam Deck / Gamescope / handheld
export QT_AUTO_SCREEN_SCALE_FACTOR=1
if [[ -f "${HERE}/detect-ui-scale.sh" ]]; then
  # shellcheck disable=SC1091
  source "${HERE}/detect-ui-scale.sh"
  detect_ui_scale
else
  export QT_SCALE_FACTOR="${QT_SCALE_FACTOR:-1.35}"
  export YTMUSIC_DECKY_UI_SCALE="${YTMUSIC_DECKY_UI_SCALE:-${QT_SCALE_FACTOR}}"
fi

# MPRIS: usar bus de sesión del host
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/user/$(id -u)/bus}"

cd "${HERE}"
exec "${HERE}/ytmusic-steamOS" "$@"
